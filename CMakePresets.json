{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MAYAFLUX_BUILD_TESTS": "OFF",
        "MAYAFLUX_BUILD_PROJECT": "OFF",
        "MAYAFLUX_ENABLE_LTO": "OFF"
      }
    },
    {
      "name": "base-dev",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "base-ship",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MAYAFLUX_ENABLE_LTO": "ON"
      }
    },
    {
      "name": "windows-vs-base",
      "hidden": true,
      "toolchainFile": "$env{MAYAFLUX_TOOLCHAIN_FILE}",
      "binaryDir": "${sourceDir}/build-vs",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_VS_GLOBALS": "UseMultiToolTask=true;EnforceProcessCountAcrossBuilds=true",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MAYAFLUX_BUILD_TESTS": "OFF",
        "MAYAFLUX_BUILD_PROJECT": "OFF",
        "MAYAFLUX_ENABLE_LTO": "OFF"
      }
    },
    {
      "name": "unix-dev",
      "inherits": "base-dev",
      "displayName": "Unix : Development",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "MAYAFLUX_DEV": "ON",
        "MAYAFLUX_BUILD_PROJECT": "ON",
        "MAYAFLUX_PORTABLE": "ON",
        "EXAMPLE_SHADER_DIR": "${sourceDir}/src/examples/shaders"
      }
    },
    {
      "name": "unix-test",
      "inherits": "unix-dev",
      "displayName": "Unix : Development with tests",
      "cacheVariables": {
        "MAYAFLUX_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-check",
      "inherits": "base-dev",
      "displayName": "Linux : CI build check",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "MAYAFLUX_PORTABLE": "ON"
      }
    },
    {
      "name": "linux-test",
      "inherits": "linux-check",
      "displayName": "Linux : CI build with tests",
      "cacheVariables": {
        "MAYAFLUX_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-ship",
      "inherits": "base-ship",
      "displayName": "Linux : Shipping build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "/usr"
      }
    },
    {
      "name": "launchpad-ship",
      "inherits": "base-ship",
      "displayName": "MayaFlux: Launchpad/PPA",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_LIBDIR": "lib"
      }
    },
    {
      "name": "macos-check",
      "inherits": "base-dev",
      "displayName": "macOS : CI build check",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_VERBOSE_MAKEFILE": "ON",
        "MAYAFLUX_PORTABLE": "ON"
      }
    },
    {
      "name": "macos-test",
      "inherits": "macos-check",
      "displayName": "macOS : CI build with tests",
      "cacheVariables": {
        "MAYAFLUX_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "macos-ship",
      "inherits": "base-ship",
      "displayName": "macOS : Shipping build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_VERBOSE_MAKEFILE": "ON",
        "MAYAFLUX_PORTABLE": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "$env{MAYAFLUX_TOOLCHAIN_FILE}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "windows-dev",
      "inherits": [ "base-dev", "windows-base" ],
      "displayName": "Windows : MSVC Development",
      "description": "Uses the x64 MSVC and Windows SDK environment configured by scripts/win64/setup_windows.ps1.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "C:/MayaFlux",
        "CMAKE_PREFIX_PATH": "",
        "MAYAFLUX_DEV": "ON",
        "MAYAFLUX_BUILD_PROJECT": "ON",
        "EXAMPLE_SHADER_DIR": "${sourceDir}/src/examples/shaders"
      }
    },
    {
      "name": "windows-test",
      "inherits": "windows-dev",
      "displayName": "Windows : MSVC Development with tests",
      "cacheVariables": {
        "MAYAFLUX_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-check",
      "inherits": [ "base-dev", "windows-base" ],
      "displayName": "Windows : CI build check",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "C:/MayaFlux"
      }
    },
    {
      "name": "windows-check-test",
      "inherits": "windows-check",
      "displayName": "Windows : CI build with tests",
      "cacheVariables": {
        "MAYAFLUX_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-ship",
      "inherits": [ "base-ship", "windows-base" ],
      "displayName": "Windows : Shipping build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "C:/MayaFlux",
        "MAYAFLUX_ENABLE_LTO": "ON"
      }
    },
    {
      "name": "windows-vs2026-dev",
      "inherits": "windows-vs-base",
      "displayName": "Windows (VS 2026) - Development",
      "generator": "Visual Studio 18 2026",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "C:/MayaFlux",
        "CMAKE_PREFIX_PATH": "",
        "MAYAFLUX_DEV": "ON",
        "MAYAFLUX_BUILD_PROJECT": "ON",
        "EXAMPLE_SHADER_DIR": "${sourceDir}/src/examples/shaders"
      }
    },
    {
      "name": "windows-vs2022-dev",
      "inherits": "windows-vs-base",
      "displayName": "Windows (VS 2022) - Development",
      "generator": "Visual Studio 17 2022",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "C:/MayaFlux",
        "CMAKE_PREFIX_PATH": "",
        "MAYAFLUX_DEV": "ON",
        "MAYAFLUX_BUILD_PROJECT": "ON",
        "EXAMPLE_SHADER_DIR": "${sourceDir}/src/examples/shaders"
      }
    },
    {
      "name": "windows-vs-ship",
      "inherits": [ "base-ship", "windows-vs-base" ],
      "binaryDir": "${sourceDir}/build-vs",
      "displayName": "Windows : Visual Studio Shipping build",
      "generator": "Visual Studio 18 2026",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "C:/MayaFlux",
        "MAYAFLUX_ENABLE_LTO": "ON"
      }
    },
    {
      "name": "unix-coverage",
      "inherits": "unix-test",
      "displayName": "Unix : Test coverage",
      "binaryDir": "${sourceDir}/build-coverage",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "MAYAFLUX_COVERAGE": "ON"
      }
    },
    {
      "name": "windows-coverage",
      "inherits": [ "base-dev", "windows-base" ],
      "displayName": "Windows : Clang test coverage",
      "description": "gcov coverage needs Clang or GCC, so this overrides the MSVC compilers from windows-base. clang and clang++ must be on PATH, with llvm-cov and gcovr.",
      "binaryDir": "${sourceDir}/build-coverage",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "MAYAFLUX_BUILD_TESTS": "ON",
        "MAYAFLUX_COVERAGE": "ON"
      }
    },
    {
      "name": "unix-tsan",
      "inherits": "unix-test",
      "displayName": "Unix : ThreadSanitizer tests",
      "description": "Instruments the library and the tests with ThreadSanitizer. Needs its own build directory; cannot be combined with AddressSanitizer.",
      "binaryDir": "${sourceDir}/build-tsan",
      "environment": {
        "CFLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CXXFLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "LDFLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "windows-asan",
      "inherits": "windows-test",
      "displayName": "Windows : MSVC AddressSanitizer tests",
      "description": "Neither MSVC nor Clang on Windows ships ThreadSanitizer, so AddressSanitizer is the sanitizer available here. Needs its own build directory.",
      "binaryDir": "${sourceDir}/build-asan",
      "environment": {
        "CFLAGS": "/fsanitize=address",
        "CXXFLAGS": "/fsanitize=address",
        "LDFLAGS": "/INCREMENTAL:NO"
      },
      "cacheVariables": {
        "MAYAFLUX_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "unix-dev",           "configurePreset": "unix-dev", "jobs": 0 },
    { "name": "unix-test",          "configurePreset": "unix-test", "jobs": 0 },
    { "name": "linux-check",        "configurePreset": "linux-check", "jobs": 0 },
    { "name": "linux-test",         "configurePreset": "linux-test", "jobs": 0 },
    { "name": "linux-ship",         "configurePreset": "linux-ship", "jobs": 0 },
    { "name": "launchpad-ship",     "configurePreset": "launchpad-ship", "jobs": 0 },
    { "name": "macos-check",        "configurePreset": "macos-check", "jobs": 0 },
    { "name": "macos-test",         "configurePreset": "macos-test", "jobs": 0 },
    { "name": "macos-ship",         "configurePreset": "macos-ship", "jobs": 0 },
    { "name": "windows-dev",        "configurePreset": "windows-dev", "jobs": 0 },
    { "name": "windows-test",       "configurePreset": "windows-test", "jobs": 0 },
    { "name": "windows-check",      "configurePreset": "windows-check", "jobs": 0 },
    { "name": "windows-check-test", "configurePreset": "windows-check-test", "jobs": 0 },
    { "name": "windows-ship",       "configurePreset": "windows-ship", "jobs": 0 },
    { "name": "windows-vs2026-dev", "configurePreset": "windows-vs2026-dev", "configuration": "RelWithDebInfo" },
    { "name": "windows-vs2022-dev", "configurePreset": "windows-vs2022-dev", "configuration": "RelWithDebInfo" },
    { "name": "windows-vs-ship",   "configurePreset": "windows-vs-ship", "configuration": "RelWithDebInfo" },
    { "name": "unix-tsan", "configurePreset": "unix-tsan", "jobs": 0 },
    { "name": "windows-asan", "configurePreset": "windows-asan", "jobs": 0 },
    { "name": "unix-coverage", "configurePreset": "unix-coverage", "targets": [ "coverage" ], "jobs": 0 },
    { "name": "windows-coverage", "configurePreset": "windows-coverage", "targets": [ "coverage" ], "jobs": 0 }
  ],
  "testPresets": [
    {
      "name": "unix-test",
      "configurePreset": "unix-test",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-test",
      "configurePreset": "linux-test",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-test",
      "configurePreset": "macos-test",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-test",
      "configurePreset": "windows-test",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-check-test",
      "configurePreset": "windows-check-test",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "unix-tsan",
      "configurePreset": "unix-tsan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-asan",
      "configurePreset": "windows-asan",
      "output": { "outputOnFailure": true }
    }
  ]
}
