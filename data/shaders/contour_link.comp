#version 460
#include "include/vision_cc.glsl"

layout(local_size_x = 256) in;

struct Segment {
    uint label_id;
    uint gx0;
    uint gy0;
    uint gx1;
    uint gy1;
    float x0;
    float y0;
    float x1;
    float y1;
};

layout(set = 1, binding = 0, std430) buffer SegmentBuf {
    Segment segments[];
};

layout(set = 1, binding = 1, std430) buffer SegmentCountBuf {
    uint segment_count[1];
};

layout(set = 1, binding = 2, std430) buffer EndpointSlots {
    uint endpoint_slots[];
};

struct SegmentLinks {
    uint next_at_start;
    uint next_at_end;
};

layout(set = 1, binding = 3, std430) buffer SegmentLinkBuf {
    SegmentLinks segment_links[];
};

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint phase;
} pc;

/**
 * @brief Grid index from exact integer pixel-boundary coordinates, no
 *        float round-trip. gx in [0, width], gy in [0, height].
 */
uint grid_index(uint gx, uint gy)
{
    return (gy * (pc.width + 1u) + gx) * 2u;
}

void claim_slot(uint base, uint seg_idx)
{
    if (atomicCompSwap(endpoint_slots[base], 0xFFFFFFFFu, seg_idx) == 0xFFFFFFFFu)
        return;
    atomicCompSwap(endpoint_slots[base + 1u], 0xFFFFFFFFu, seg_idx);
}

uint other_at(uint base, uint seg_idx)
{
    const uint a = endpoint_slots[base];
    const uint b = endpoint_slots[base + 1u];
    if (a != seg_idx && a != 0xFFFFFFFFu)
        return a;
    if (b != seg_idx && b != 0xFFFFFFFFu)
        return b;
    return 0xFFFFFFFFu;
}

void main()
{
    const uint idx = gl_GlobalInvocationID.x;
    if (idx >= segment_count[0])
        return;

    const Segment s = segments[idx];

    if (pc.phase == 0u) {
        claim_slot(grid_index(s.gx0, s.gy0), idx);
        claim_slot(grid_index(s.gx1, s.gy1), idx);
        return;
    }

    segment_links[idx].next_at_start = other_at(grid_index(s.gx0, s.gy0), idx);
    segment_links[idx].next_at_end = other_at(grid_index(s.gx1, s.gy1), idx);
}
