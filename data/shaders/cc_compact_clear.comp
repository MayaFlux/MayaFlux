#version 460
#include "include/vision_common.glsl"
#include "include/vision_cc.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 1, rgba32f) readonly uniform image2D in_labels;

layout(set = 0, binding = 0, std430) buffer LookupBuf {
    uint lookup[];
};

layout(set = 0, binding = 2, std430) buffer CounterBuf {
    uint count[1];
};

layout(set = 0, binding = 4, std430) buffer BoxBuf {
    uint box_extents[];
};

layout(push_constant) uniform PC {
    uint width;
    uint height;
    uint max_components;
} pc;

/**
 * @brief Zero-fills lookup across every flat pixel index and writes the
 *        min/max sentinel pattern into the first max_components slots of
 *        box_extents, entirely on GPU. lookup is sized width * height;
 *        box_extents is sized max_components * 5.
 */
void main()
{
    ivec2 coord = thread_coord();
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height))
        return;

    uint flat_idx = uint(coord.y) * pc.width + uint(coord.x);
    lookup[flat_idx] = CC_UNCLAIMED;

    if (flat_idx == 0u)
        count[0] = 0u;

    if (flat_idx < pc.max_components) {
        uint base = flat_idx * 5u;
        box_extents[base + 0u] = 0xFFFFFFFFu;
        box_extents[base + 1u] = 0xFFFFFFFFu;
        box_extents[base + 2u] = 0u;
        box_extents[base + 3u] = 0u;
        box_extents[base + 4u] = 0u;
    }
}
