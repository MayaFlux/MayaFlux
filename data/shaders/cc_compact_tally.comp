#version 460

#include "include/vision_common.glsl"
#include "include/vision_cc.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 1, rgba32f) readonly uniform image2D in_labels;

layout(set = 0, binding = 0, std430) buffer LookupBuf {
    uint lookup[];
};

layout(push_constant) uniform PC {
    uint width;
    uint height;
} pc;

/**
 * @brief Tallies pixel count per raw equivalence-class root label into
 *        lookup, reused as a histogram. lookup must be zero-initialised
 *        before dispatch by cc_compact_clear.
 */
void main()
{
    ivec2 coord = thread_coord();
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height))
        return;

    uint root = floatBitsToUint(imageLoad(in_labels, coord).r);
    if (root == CC_BACKGROUND)
        return;

    atomicAdd(lookup[root], 1u);
}
