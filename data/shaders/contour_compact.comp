#version 460
#extension GL_EXT_buffer_reference : require
#include "include/vision_cc.glsl"

layout(local_size_x = 256) in;

layout(buffer_reference, std430) buffer TraceOwnerBufRef {
    uint v[];
};

layout(buffer_reference, std430) buffer HoleOwnerBufRef {
    uint v[];
};

layout(buffer_reference, std430) buffer CompactedOwnersBufRef {
    uvec2 v[];
};

layout(buffer_reference, std430) buffer CompactedCountBufRef {
    uint v[];
};

layout(push_constant) uniform PushConstants {
    TraceOwnerBufRef trace_owner;
    HoleOwnerBufRef hole_owner;
    CompactedOwnersBufRef compacted_owners;
    CompactedCountBufRef compacted_count;
    uint max_components;
    uint max_holes_per_label;
} pc;

const uint HOLE_FLAG = 0x80000000u;

/**
 * @brief Scans the fixed-size ownership tables (not the image) and
 *        appends one compacted entry per claimed outer owner and per
 *        claimed hole slot. Dispatched over max_components * (1 +
 *        max_holes_per_label) threads, independent of image resolution.
 */
void main()
{
    const uint idx = gl_GlobalInvocationID.x;
    const uint total_slots = pc.max_components * (1u + pc.max_holes_per_label);
    if (idx >= total_slots)
        return;

    if (idx < pc.max_components) {
        const uint label = idx + 1u;
        const uint owner = pc.trace_owner.v[label];
        if (owner == CC_UNCLAIMED)
            return;

        const uint slot = atomicAdd(pc.compacted_count.v[0], 1u);
        pc.compacted_owners.v[slot] = uvec2(owner, idx);
        return;
    }

    const uint hole_idx = idx - pc.max_components;
    const uint owner = pc.hole_owner.v[hole_idx];
    if (owner == CC_UNCLAIMED)
        return;

    const uint label = hole_idx / pc.max_holes_per_label;
    const uint hole_slot = hole_idx % pc.max_holes_per_label;
    const uint slot = atomicAdd(pc.compacted_count.v[0], 1u);
    pc.compacted_owners.v[slot] = uvec2(owner, HOLE_FLAG | (hole_slot << 12) | label);
}
