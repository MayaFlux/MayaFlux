#version 460
#include "include/vision_common.glsl"
#include "include/vision_cc.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 1, rgba32f) uniform readonly image2D in_image;

layout(set = 0, binding = 2, std430) buffer ParentBuf {
    uint parent[];
};

layout(set = 0, binding = 3, std430) buffer ChangedBuf {
    uint changed[1];
};

layout(set = 0, binding = 4, std430) buffer LabelLutBuf {
    uint label_lut[];
};

layout(set = 0, binding = 5, std430) buffer CountBuf {
    uint compact_count[1];
};

layout(set = 0, binding = 6, std430) buffer DenseBuf {
    uint dense_label[];
};

layout(set = 0, binding = 7, std430) buffer BoundsMinBuf {
    uvec2 bounds_min[];
};

layout(set = 0, binding = 8, std430) buffer BoundsMaxBuf {
    uvec2 bounds_max[];
};

layout(set = 0, binding = 9, std430) buffer BoundsCountBuf {
    uint bounds_count[];
};

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint max_components;
} pc;

/**
 * @brief Finds the root of x with path halving.
 */
uint find_root(uint x)
{
    uint p = parent[x];
    while (p != x) {
        uint gp = parent[p];
        atomicCompSwap(parent[x], p, gp);
        x = p;
        p = parent[x];
    }
    return x;
}

/**
 * @brief Claim stage: exactly one invocation per unique root increments
 *        compact_count, determined by which invocation's atomicCompSwap
 *        against the CC_UNCLAIMED sentinel actually succeeds. Losing
 *        invocations observe a non-CC_UNCLAIMED value (either the
 *        in-flight sentinel or the final id) and never increment. No
 *        invocation waits on another within this dispatch; label_lut is
 *        guaranteed settled to its final id by the time cc_compact_resolve
 *        runs as a separate, later dispatch.
 */
void claim_dense_id(uint root)
{
    uint prev = atomicCompSwap(label_lut[root], CC_UNCLAIMED, 0xFFFFFFFEu);
    if (prev != CC_UNCLAIMED)
        return;

    uint new_id = atomicAdd(compact_count[0], 1u) + 1u;
    atomicExchange(label_lut[root], new_id);
}

void main()
{
    const ivec2 coord = thread_coord();
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height))
        return;

    const uint idx = cc_flat_index(uvec2(coord), pc.width);
    const uint p = parent[idx];

    if (p == CC_BACKGROUND)
        return;

    const uint root = find_root(idx);
    claim_dense_id(root);
}
