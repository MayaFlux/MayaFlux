#version 460
#extension GL_EXT_buffer_reference : require
layout(local_size_x = 256) in;

layout(set = 0, binding = 0, rgba32f) uniform writeonly image2D out_image;

layout(buffer_reference, std430) readonly buffer FlatPointsBufRef {
    vec2 v[];
};

layout(buffer_reference, std430) readonly buffer ContourMetaBufRef {
    uvec4 v[];
};

layout(buffer_reference, std430) readonly buffer SortIndicesBufRef {
    float v[];
};

layout(push_constant) uniform PushConstants {
    FlatPointsBufRef flat_points;
    ContourMetaBufRef contour_meta;
    SortIndicesBufRef sort_indices;
    uint width;
    uint height;
    uint max_components;
    uint max_points_per_contour;
    uint max_contours;
} pc;

void plot(ivec2 p)
{
    if (p.x >= 0 && p.x < int(pc.width) && p.y >= 0 && p.y < int(pc.height))
        imageStore(out_image, p, vec4(1.0, 1.0, 1.0, 1.0));
}

void draw_line(ivec2 a, ivec2 b)
{
    int dx = abs(b.x - a.x), sx = a.x < b.x ? 1 : -1;
    int dy = -abs(b.y - a.y), sy = a.y < b.y ? 1 : -1;
    int err = dx + dy;
    ivec2 p = a;
    for (int i = 0; i < 4096; ++i) {
        plot(p);
        if (p == b)
            break;
        int e2 = 2 * err;
        if (e2 >= dy) {
            err += dy;
            p.x += sx;
        }
        if (e2 <= dx) {
            err += dx;
            p.y += sy;
        }
    }
}

void main()
{
    const uint idx = gl_GlobalInvocationID.x;
    const uint slot = idx / pc.max_points_per_contour;
    const uint edge = idx % pc.max_points_per_contour;

    const uint limit = pc.max_contours > 0u ? min(pc.max_contours, pc.max_components) : pc.max_components;
    if (slot >= limit)
        return;

    const uint contour_idx = pc.max_contours > 0u
        ? uint(pc.sort_indices.v[slot]) : slot;

    if (contour_idx >= pc.max_components)
        return;

    const uvec4 m = pc.contour_meta.v[contour_idx];
    const uint n = m.y;
    if (n < 3u || edge >= n)
        return;

    const uint base = m.x;
    const vec2 a = pc.flat_points.v[base + edge];
    const vec2 b = pc.flat_points.v[base + ((edge + 1u) % n)];
    const ivec2 pa = ivec2(a.x * float(pc.width), a.y * float(pc.height));
    const ivec2 pb = ivec2(b.x * float(pc.width), b.y * float(pc.height));
    draw_line(pa, pb);
}
