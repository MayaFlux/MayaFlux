#version 460

layout(local_size_x = 256) in;

layout(set = 1, binding = 2, std430) buffer EndpointSlots {
    uint endpoint_slots[];
};

layout(push_constant) uniform PushConstants {
    uint slot_count;
} pc;

/**
 * @brief Resets contour_link's endpoint claim buffer on GPU. Replaces a
 *        CPU-constructed-and-uploaded full-grid vector every frame with
 *        a single dispatch, mirroring cc_reset's pattern.
 */
void main()
{
    const uint i = gl_GlobalInvocationID.x;
    if (i < pc.slot_count)
        endpoint_slots[i] = 0xFFFFFFFFu;
}
