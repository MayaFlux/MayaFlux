#version 460
#extension GL_EXT_buffer_reference : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 1, std430) buffer DetCountBuf {
    uint det_count[];
};

layout(set = 0, binding = 2, std430) buffer DetPointsBuf {
    vec4 det_points[];
};

layout(buffer_reference, std430) buffer PrevCountBufRef {
    uint v[];
};

layout(buffer_reference, std430) buffer PrevPointsBufRef {
    vec4 v[];
};

layout(buffer_reference, std430) buffer TracksBufRef {
    vec4 v[];
};

layout(buffer_reference, std430) buffer MetaBufRef {
    uint v[];
};

layout(buffer_reference, std430) buffer NextPointsBufRef {
    vec4 v[];
};

layout(buffer_reference, std430) buffer CounterBufRef {
    uint v[];
};

layout(buffer_reference, std430) buffer HistogramBufRef {
    uint v[];
};

layout(buffer_reference, std430) buffer GridBufRef {
    uint v[];
};

layout(buffer_reference, std430) buffer ExportBufARef {
    vec4 v[];
};

layout(buffer_reference, std430) buffer ExportBufBRef {
    vec4 v[];
};

layout(buffer_reference, std430) buffer DispatchArgsBufRef {
    uint v[];
};

layout(push_constant) uniform PC {
    PrevCountBufRef prev_count;
    PrevPointsBufRef prev_points;
    TracksBufRef tracks;
    MetaBufRef meta;
    NextPointsBufRef next_points;
    CounterBufRef ctr;
    HistogramBufRef hist;
    GridBufRef grid;
    ExportBufARef export_a;
    ExportBufBRef export_b;
    DispatchArgsBufRef args;
    uint phase;
    uint max_points;
    uint have_prev;
    uint grid_w;
    uint grid_h;
    uint grid_cells;
    float cell;
    float base_w;
    float base_h;
    uint publish_slot;
    uint duplicate_cutoff;
} pc;

const uint PHASE_CLEAR = 0u;
const uint PHASE_SURVIVORS = 1u;
const uint PHASE_HISTOGRAM = 2u;
const uint PHASE_THRESHOLD = 3u;
const uint PHASE_ADD_STRONG = 4u;
const uint PHASE_ADD_MARGINAL = 5u;
const uint PHASE_COMMIT = 6u;
const uint PHASE_PUBLISH = 7u;
const uint PHASE_ARGS = 8u;

const uint LOCAL_SIZE = 256u;

const uint CTR_NEXT_COUNT = 0u;
const uint CTR_NEXT_ID = 1u;
const uint CTR_FULL_FROM = 2u;

const uint MAX_DETECTIONS = 4096u;
const uint BINS = 256u;

/**
 * @brief Occupancy grid cell of a normalised position. One new point is
 *        admitted per cell, which keeps detections from clumping.
 */
uint cell_of(vec2 p)
{
    const vec2 px = max(p, vec2(0.0)) * vec2(pc.base_w, pc.base_h) / pc.cell;
    const uvec2 c = min(uvec2(px), uvec2(pc.grid_w - 1u, pc.grid_h - 1u));
    return c.y * pc.grid_w + c.x;
}

uint response_bin(float response)
{
    return min(uint(clamp(response, 0.0, 1.0) * 255.0), BINS - 1u);
}

/**
 * @brief Claim the point's grid cell and append it to the next point list as
 *        a new track with a fresh id and age zero.
 */
void add_detection(vec4 d)
{
    if (atomicCompSwap(pc.grid.v[cell_of(d.xy)], 0u, 1u) != 0u)
        return;

    const uint slot = atomicAdd(pc.ctr.v[CTR_NEXT_COUNT], 1u);
    if (slot >= pc.max_points)
        return;

    const uint id = atomicAdd(pc.ctr.v[CTR_NEXT_ID], 1u);
    pc.next_points.v[2u * slot] = vec4(d.xy, d.z, uintBitsToFloat(id));
    pc.next_points.v[2u * slot + 1u] = vec4(0.0);
}

/**
 * @brief Builds the next frame's point list on the GPU, one phase per
 *        dispatch, selected by push constant.
 *
 * Survivors keep their id and age and move to their tracked position. New
 * detections then fill only the free capacity, strongest response first: a
 * 256 bin response histogram of the candidates in free grid cells yields the
 * lowest bin whose suffix still fits, everything at or above it is admitted,
 * and the one bin just below competes for what remains. This ranks without a
 * sort, and the cell claim admits at most one new point per grid cell.
 *
 * The final phase runs in a single workgroup and promotes the next list to
 * the previous list, so the count is read before anything it describes is
 * overwritten. The detection counter is left at zero for the next frame.
 *
 * The publish phase copies this frame's tracks into the export buffer chosen
 * by publish_slot: a header vec4 carrying the track count as uint bits in x,
 * then the track records unchanged. It writes nothing when the frame repeats
 * the previous one and a cutoff above the frame's intensity change was
 * supplied, so the buffer of the last distinct frame stays intact.
 *
 * The args phase runs once, right after detection, and writes the workgroup
 * counts of the stages that follow as four {x, y, z} triples, so those stages
 * launch exactly the groups they need and the counts never reach the host:
 * the Lucas-Kanade dispatches (one group per retained point), the survivor
 * and publish phases (one thread per retained point, at least one group so the
 * publish header is always written), and the detection phases (one thread per
 * detection).
 */
void main()
{
    const uint i = gl_GlobalInvocationID.x;
    const uint lid = gl_LocalInvocationIndex;

    switch (pc.phase) {
    case PHASE_CLEAR: {
        if (i < pc.grid_cells)
            pc.grid.v[i] = 0u;
        if (i < BINS)
            pc.hist.v[i] = 0u;
        if (i == 0u)
            pc.ctr.v[CTR_NEXT_COUNT] = 0u;
        break;
    }
    case PHASE_SURVIVORS: {
        if (pc.have_prev == 0u)
            break;
        if (i >= min(pc.prev_count.v[0], pc.max_points))
            break;

        const vec4 status = pc.tracks.v[2u * i + 1u];
        if (status.y < 0.5)
            break;

        const vec4 pose = pc.tracks.v[2u * i];
        const vec4 old_point = pc.prev_points.v[2u * i];
        const vec4 old_meta = pc.prev_points.v[2u * i + 1u];

        const uint slot = atomicAdd(pc.ctr.v[CTR_NEXT_COUNT], 1u);
        if (slot >= pc.max_points)
            break;

        pc.next_points.v[2u * slot] = vec4(pose.xy, old_point.z, old_point.w);
        pc.next_points.v[2u * slot + 1u] = vec4(uintBitsToFloat(floatBitsToUint(old_meta.x) + 1u), 0.0, 0.0, 0.0);
        pc.grid.v[cell_of(pose.xy)] = 1u;
        break;
    }
    case PHASE_HISTOGRAM: {
        if (i >= min(det_count[0], MAX_DETECTIONS))
            break;

        const vec4 d = det_points[i];
        if (pc.grid.v[cell_of(d.xy)] != 0u)
            break;

        atomicAdd(pc.hist.v[response_bin(d.z)], 1u);
        break;
    }
    case PHASE_THRESHOLD: {
        if (i != 0u)
            break;

        const uint free_slots = pc.max_points - min(pc.ctr.v[CTR_NEXT_COUNT], pc.max_points);
        uint cumulative = 0u;
        uint full_from = BINS;
        for (int b = int(BINS) - 1; b >= 0; --b) {
            const uint h = pc.hist.v[b];
            if (cumulative + h > free_slots)
                break;
            cumulative += h;
            full_from = uint(b);
        }
        pc.ctr.v[CTR_FULL_FROM] = full_from;
        break;
    }
    case PHASE_ADD_STRONG: {
        if (i >= min(det_count[0], MAX_DETECTIONS))
            break;

        const vec4 d = det_points[i];
        if (response_bin(d.z) < pc.ctr.v[CTR_FULL_FROM])
            break;
        add_detection(d);
        break;
    }
    case PHASE_ADD_MARGINAL: {
        const uint full_from = pc.ctr.v[CTR_FULL_FROM];
        if (full_from == 0u || i >= min(det_count[0], MAX_DETECTIONS))
            break;

        const vec4 d = det_points[i];
        if (response_bin(d.z) != full_from - 1u)
            break;
        add_detection(d);
        break;
    }
    case PHASE_COMMIT: {
        const uint n = min(pc.ctr.v[CTR_NEXT_COUNT], pc.max_points);
        memoryBarrierBuffer();
        barrier();

        for (uint k = lid; k < n * 2u; k += 256u)
            pc.prev_points.v[k] = pc.next_points.v[k];

        memoryBarrierBuffer();
        barrier();

        if (lid == 0u) {
            pc.prev_count.v[0] = n;
            det_count[0] = 0u;
        }
        break;
    }
    case PHASE_ARGS: {
        if (i != 0u)
            break;

        const uint retained = pc.have_prev != 0u ? min(pc.prev_count.v[0], pc.max_points) : 0u;
        const uint detected = min(det_count[0], MAX_DETECTIONS);
        const uint retained_groups = (retained + LOCAL_SIZE - 1u) / LOCAL_SIZE;
        const uint detected_groups = (detected + LOCAL_SIZE - 1u) / LOCAL_SIZE;

        pc.args.v[0] = retained;
        pc.args.v[1] = 1u;
        pc.args.v[2] = 1u;
        pc.args.v[3] = retained_groups;
        pc.args.v[4] = 1u;
        pc.args.v[5] = 1u;
        pc.args.v[6] = detected_groups;
        pc.args.v[7] = 1u;
        pc.args.v[8] = 1u;
        pc.args.v[9] = max(retained_groups, 1u);
        pc.args.v[10] = 1u;
        pc.args.v[11] = 1u;
        break;
    }
    case PHASE_PUBLISH: {
        if (pc.have_prev != 0u && pc.meta.v[1] < pc.duplicate_cutoff)
            break;

        const uint count = pc.have_prev != 0u ? min(pc.meta.v[0], pc.max_points) : 0u;

        if (pc.publish_slot == 0u) {
            if (i == 0u)
                pc.export_a.v[0] = vec4(uintBitsToFloat(count), 0.0, 0.0, 0.0);
            if (i < count) {
                pc.export_a.v[1u + 2u * i] = pc.tracks.v[2u * i];
                pc.export_a.v[2u + 2u * i] = pc.tracks.v[2u * i + 1u];
            }
        } else {
            if (i == 0u)
                pc.export_b.v[0] = vec4(uintBitsToFloat(count), 0.0, 0.0, 0.0);
            if (i < count) {
                pc.export_b.v[1u + 2u * i] = pc.tracks.v[2u * i];
                pc.export_b.v[2u + 2u * i] = pc.tracks.v[2u * i + 1u];
            }
        }
        break;
    }
    }
}
