#version 460

#include "include/vision_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) writeonly uniform image2D out_image;
layout(set = 0, binding = 1, rgba32f) readonly uniform image2D in_image;

layout(push_constant) uniform PC {
    uint block_size;
    float offset;
    uint channels;
} pc;

/**
 * @brief Adaptive threshold. Each pixel compares against the mean of its
 *        block_size x block_size clamped neighbourhood minus offset.
 *        pc.channels selects the channels tested, all of which must pass;
 *        zero tests channel 0 only.
 */
void main()
{
    const ivec2 coord = thread_coord();
    const ivec2 sz = imageSize(out_image);
    if (coord.x >= sz.x || coord.y >= sz.y)
        return;

    const int half_block = int(pc.block_size) / 2;
    vec3 sum = vec3(0.0);
    int count = 0;

    for (int dy = -half_block; dy <= half_block; ++dy) {
        for (int dx = -half_block; dx <= half_block; ++dx) {
            sum += sample_clamped(in_image, coord + ivec2(dx, dy)).rgb;
            ++count;
        }
    }

    const vec3 mean = sum / float(count);
    const vec3 self = sample_clamped(in_image, coord).rgb;
    const uint mask = pc.channels == 0u ? 1u : pc.channels;

    bool pass = true;
    for (uint c = 0u; c < 3u; ++c) {
        if ((mask & (1u << c)) != 0u)
            pass = pass && (self[c] >= (mean[c] - pc.offset));
    }

    const float result = pass ? 1.0 : 0.0;
    imageStore(out_image, coord, vec4(result, result, result, 1.0));
}
