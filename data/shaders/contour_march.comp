#version 460
#include "include/vision_cc.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 6, std430) buffer DenseLabelBuf {
    uint dense_label[];
};

layout(set = 1, binding = 4, std430) buffer TraceOwnerBuf {
    uint trace_owner[];
};

/**
 * @brief Hole trace ownership, indexed by (label - 1) * k_max_holes_per_label + slot.
 *        A hole-start pixel claims the first free slot for its parent
 *        label via a linear scan over the small fixed cap, so multiple
 *        holes on the same component land in distinct slots without
 *        needing dynamic allocation.
 */
layout(set = 1, binding = 8, std430) buffer HoleOwnerBuf {
    uint hole_owner[];
};

layout(set = 1, binding = 5, std430) buffer ContourPointsBuf {
    vec2 contour_points[];
};

layout(set = 1, binding = 6, std430) buffer ContourPointCountBuf {
    uint contour_point_count[];
};

layout(set = 1, binding = 7, std430) buffer AreaPerimeterBuf {
    vec2 area_perimeter[];
};

/**
 * @brief Hole equivalents of ContourPointsBuf / ContourPointCountBuf /
 *        AreaPerimeterBuf, indexed the same way as HoleOwnerBuf.
 */
layout(set = 1, binding = 9, std430) buffer HolePointsBuf {
    vec2 hole_points[];
};

layout(set = 1, binding = 10, std430) buffer HolePointCountBuf {
    uint hole_point_count[];
};

layout(set = 1, binding = 11, std430) buffer HoleAreaPerimeterBuf {
    vec2 hole_area_perimeter[];
};

layout(set = 1, binding = 12, std430) buffer HoleClaimFlagBuf {
    uint hole_claim_flag[];
};

layout(set = 2, binding = 0, std430) buffer SortKeysBuf {
    float sort_keys[];
};

layout(set = 2, binding = 1, std430) buffer SortIndicesBuf {
    float sort_indices[];
};

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint max_components;
    uint max_points_per_contour;
    uint max_holes_per_label;
    uint phase;
    float min_area;
} pc;

const float NEG_INFINITY = -1.0 / 0.0;

bool is_background(uint label)
{
    return label == CC_BACKGROUND || label == 0u;
}

uint label_at(int x, int y)
{
    if (x < 0 || y < 0 || x >= int(pc.width) || y >= int(pc.height))
        return CC_BACKGROUND;
    return dense_label[uint(y) * pc.width + uint(x)];
}

/**
 * @brief Phase 0: claims trace ownership for outer boundaries (unchanged
 *        from before) and, additionally, for hole boundaries using only
 *        dense_label. A hole start point is a foreground pixel whose
 *        right neighbour is background, mirroring the outer start's
 *        left-neighbour test, per Suzuki-Abe's local border-start rule.
 *        No second label field, no separate connectivity pass: holes are
 *        detected as a transition condition on the same buffer the
 *        outer trace already reads.
 */
void claim_phase()
{
    const ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    const uint linear_idx = gl_GlobalInvocationID.y * pc.width + gl_GlobalInvocationID.x;

    if (coord.x < int(pc.width) && coord.y < int(pc.height))
        hole_claim_flag[linear_idx] = 0u;

    const uint here = label_at(coord.x, coord.y);
    if (is_background(here) || here > pc.max_components)
        return;

    const uint left = label_at(coord.x - 1, coord.y);
    const uint above = label_at(coord.x, coord.y - 1);

    bool is_outer_start = (left != here);
    if (is_outer_start && above == here) {
        const uint above_left = label_at(coord.x - 1, coord.y - 1);
        if (above_left == here)
            is_outer_start = false;
    }

    if (is_outer_start) {
        atomicCompSwap(trace_owner[here], CC_UNCLAIMED, linear_idx);
        return;
    }

    const uint right = label_at(coord.x + 1, coord.y);
    if (!is_background(right))
        return;

    bool is_hole_start = true;
    if (above == here) {
        const uint above_right = label_at(coord.x + 1, coord.y - 1);
        if (is_background(above_right))
            is_hole_start = false;
    }
    if (!is_hole_start)
        return;

    const uint base_slot = (here - 1u) * pc.max_holes_per_label;
    for (uint s = 0u; s < pc.max_holes_per_label; ++s) {
        if (atomicCompSwap(hole_owner[base_slot + s], CC_UNCLAIMED, linear_idx) == CC_UNCLAIMED) {
            hole_claim_flag[linear_idx] = s + 1u;
            return;
        }
    }
}

/**
 * @brief Bounded Moore boundary walk. When tracing_hole is false, walks
 *        pixels equal to target_label (outer boundary). When true, walks
 *        the background pixels bordering the hole from the inside,
 *        following the same 8-direction search but testing for
 *        "background adjacent to target_label" instead of "equal to
 *        target_label" as the step-acceptance condition.
 */
void walk_boundary(
    int start_x, int start_y,
    uint target_label,
    bool tracing_hole,
    uint out_base,
    uint max_points,
    bool write_to_hole_buf,
    out uint out_count)
{
    const int dx8[8] = int[8](1, 1, 0, -1, -1, -1, 0, 1);
    const int dy8[8] = int[8](0, 1, 1, 1, 0, -1, -1, -1);

    int cx = start_x;
    int cy = start_y;

    int start_dir = 0;
    for (int d = 0; d < 8; ++d) {
        const uint n = label_at(cx + dx8[d], cy + dy8[d]);
        const bool inside = tracing_hole ? is_background(n) : (n == target_label);
        if (!inside) {
            start_dir = d;
            break;
        }
    }

    const int orig_x = cx;
    const int orig_y = cy;
    int dir = start_dir;
    bool first = true;
    uint count = 0u;

    for (uint step = 0u; step < max_points * 8u; ++step) {
        bool step_found = false;

        for (int i = 0; i < 8; ++i) {
            const int d = (dir + 6 + i) % 8;
            const int nx = cx + dx8[d];
            const int ny = cy + dy8[d];

            const uint n = label_at(nx, ny);
            const bool inside = tracing_hole ? is_background(n) : (n == target_label);
            if (!inside)
                continue;

            if (count < max_points) {
                const vec2 p = vec2(float(cx) / float(pc.width), float(cy) / float(pc.height));
                if (write_to_hole_buf)
                    hole_points[out_base + count] = p;
                else
                    contour_points[out_base + count] = p;
            }
            ++count;

            cx = nx;
            cy = ny;
            dir = d;
            step_found = true;
            break;
        }

        if (!step_found)
            break;
        if (!first && cx == orig_x && cy == orig_y)
            break;
        first = false;
        if (count >= max_points)
            break;
    }

    out_count = min(count, max_points);
}

float shoelace_area(uint out_base, uint n, bool from_hole_buf)
{
    float area = 0.0;
    for (uint j = 0u; j < n; ++j) {
        const vec2 a = from_hole_buf ? hole_points[out_base + j] : contour_points[out_base + j];
        const vec2 b = from_hole_buf ? hole_points[out_base + ((j + 1u) % n)] : contour_points[out_base + ((j + 1u) % n)];
        area += a.x * b.y - b.x * a.y;
    }
    return abs(area) * 0.5;
}

float shoelace_perimeter(uint out_base, uint n, bool from_hole_buf)
{
    float perim = 0.0;
    for (uint j = 0u; j < n; ++j) {
        const vec2 a = from_hole_buf ? hole_points[out_base + j] : contour_points[out_base + j];
        const vec2 b = from_hole_buf ? hole_points[out_base + ((j + 1u) % n)] : contour_points[out_base + ((j + 1u) % n)];
        perim += length(b - a);
    }
    return perim;
}

/**
 * @brief Phase 1: runs the bounded Moore trace for whichever ownership
 *        this invocation's pixel won in phase 0: outer boundary, a hole
 *        slot, or neither. A foreground pixel can win outer ownership;
 *        a foreground pixel with a background right-neighbour can win
 *        a hole slot. Both checks are cheap since trace_owner/hole_owner
 *        lookups are direct indexed reads.
 */
void trace_phase()
{
    const ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height))
        return;

    const uint linear_idx = gl_GlobalInvocationID.y * pc.width + gl_GlobalInvocationID.x;
    const uint here = label_at(coord.x, coord.y);
    if (is_background(here) || here > pc.max_components)
        return;

    if (trace_owner[here] == linear_idx) {
        const uint out_base = (here - 1u) * pc.max_points_per_contour;
        uint n = 0u;
        walk_boundary(coord.x, coord.y, here, false, out_base, pc.max_points_per_contour, false, n);

        contour_point_count[here - 1u] = n;
        if (n < 3u)
            return;

        const float area = shoelace_area(out_base, n, false);
        const float perimeter = shoelace_perimeter(out_base, n, false);
        const uint slot = here - 1u;
        area_perimeter[slot] = vec2(area, perimeter);

        if (area < pc.min_area) {
            contour_point_count[slot] = 0u;
            sort_keys[slot] = NEG_INFINITY;
        } else {
            sort_keys[slot] = area;
        }
        return;
    }

    const uint base_slot = (here - 1u) * pc.max_holes_per_label;
    for (uint s = 0u; s < pc.max_holes_per_label; ++s) {
        const uint claim = hole_claim_flag[linear_idx];
        if (claim == 0u)
            return;

        const uint slot_in_label = claim - 1u;
        const uint base_slot = (here - 1u) * pc.max_holes_per_label;
        const uint slot = base_slot + slot_in_label;

        const uint out_base = slot * pc.max_points_per_contour;
        uint n = 0u;
        walk_boundary(coord.x + 1, coord.y, here, true, out_base, pc.max_points_per_contour, true, n);

        hole_point_count[slot] = n;
        if (n < 3u)
            return;

        const float area = shoelace_area(out_base, n, true);
        const float perimeter = shoelace_perimeter(out_base, n, true);
        hole_area_perimeter[slot] = vec2(area, perimeter);

        if (area < pc.min_area)
            hole_point_count[slot] = 0u;
        return;
    }
}

void main()
{
    if (pc.phase == 0u)
        claim_phase();
    else
        trace_phase();
}
