#version 460
#include "include/vision_cc.glsl"

layout(local_size_x = 256) in;

struct Segment {
    uint label_id;
    uint gx0;
    uint gy0;
    uint gx1;
    uint gy1;
    float x0;
    float y0;
    float x1;
    float y1;
};

layout(set = 0, binding = 2, std430) buffer SegmentBuf {
    Segment segments[];
};

layout(set = 0, binding = 3, std430) buffer SegmentCountBuf {
    uint segment_count[1];
};

struct SegmentLinks {
    uint next_at_start;
    uint next_at_end;
};

layout(set = 0, binding = 5, std430) buffer SegmentLinkBuf {
    SegmentLinks segment_links[];
};

/**
 * @brief First-writer-wins claim: label_id -> the one segment index that
 *        owns tracing this label's boundary. Sized max_components + 1
 *        (label ids are 1-based). CC_UNCLAIMED sentinel means unclaimed.
 */
layout(set = 0, binding = 6, std430) buffer TraceOwnerBuf {
    uint trace_owner[];
};

/**
 * @brief Ordered output points, max_contours * max_points_per_contour,
 *        indexed as (label_id - 1) * max_points_per_contour + point_idx.
 */
layout(set = 0, binding = 7, std430) buffer ContourPointsBuf {
    vec2 contour_points[];
};

layout(set = 0, binding = 8, std430) buffer ContourPointCountBuf {
    uint contour_point_count[];
};

/**
 * @brief Area (x) and perimeter (y) per label slot, indexed by
 *        (label_id - 1). Written only for labels this dispatch actually
 *        traces; slots for unclaimed or untraced labels are left at
 *        whatever ensure_shared_buffer's zero-init left them.
 */
layout(set = 0, binding = 10, std430) buffer AreaPerimeterBuf {
    vec2 area_perimeter[];
};

/**
 * @brief Bitonic sort key per label slot, indexed by (label_id - 1).
 *        Valid, unfiltered labels carry their area; unclaimed or
 *        min_area-filtered labels carry -infinity so they sort last
 *        under descending order.
 */
layout(set = 0, binding = 11, std430) buffer SortKeysBuf {
    float sort_keys[];
};

/**
 * @brief Sort index per label slot, indexed by (label_id - 1). Initial
 *        value is always its own slot index; the bitonic pass permutes
 *        this buffer in place alongside SortKeysBuf.
 */
layout(set = 0, binding = 12, std430) buffer SortIndicesBuf {
    float sort_indices[];
};

layout(push_constant) uniform PushConstants {
    uint max_components;
    uint max_points_per_contour;
    uint phase;
    float min_area;
} pc;

const float NEG_INFINITY = -1.0 / 0.0;

/**
 * @brief Phase 0: each segment attempts to claim ownership of tracing
 *        its label. First segment (by dispatch order, effectively
 *        arbitrary) to claim wins; all others no-op for that label.
 *        Also initialises this label's sort slot to a filtered-out
 *        state so every slot in [0, max_components) is well-formed for
 *        the bitonic pass regardless of whether trace_phase ever visits
 *        it.
 */
void claim_phase()
{
    const uint idx = gl_GlobalInvocationID.x;

    if (idx < pc.max_components) {
        sort_keys[idx] = NEG_INFINITY;
        sort_indices[idx] = float(idx);
    }

    if (idx >= segment_count[0])
        return;

    const uint label_id = segments[idx].label_id;
    if (label_id == 0u || label_id > pc.max_components)
        return;

    atomicCompSwap(trace_owner[label_id], CC_UNCLAIMED, idx);
}

/**
 * @brief Phase 1: only threads whose segment index is the claimed owner
 *        for their label actually trace. Walks next_at_end from the
 *        owning segment's endpoint, appending the shared endpoint at
 *        each step, until the walk returns to the owning segment.
 *        Bounded by segment_count to guarantee termination even on
 *        malformed (non-closed) input. Accumulates shoelace area and
 *        perimeter over the same point sequence inline, then applies
 *        the min_area filter by zeroing contour_point_count on failure
 *        so the point set is excluded downstream exactly like an
 *        untraced label. Writes the final sort key from the (possibly
 *        filtered) area.
 */
void trace_phase()
{
    const uint idx = gl_GlobalInvocationID.x;
    if (idx >= segment_count[0])
        return;

    const uint label_id = segments[idx].label_id;
    if (label_id == 0u || label_id > pc.max_components)
        return;
    if (trace_owner[label_id] != idx)
        return;

    const uint out_base = (label_id - 1u) * pc.max_points_per_contour;

    uint count = 0u;
    uint cur = idx;
    const uint start = idx;

    for (uint step = 0u; step < segment_count[0]; ++step) {
        const Segment s = segments[cur];

        if (count < pc.max_points_per_contour)
            contour_points[out_base + count] = vec2(s.x0, s.y0);
        ++count;

        const uint next = segment_links[cur].next_at_end;
        if (next == 0xFFFFFFFFu)
            break;

        cur = next;
        if (cur == start)
            break;
    }

    const uint n = min(count, pc.max_points_per_contour);
    contour_point_count[label_id - 1u] = n;

    if (n < 3u)
        return;

    float area = 0.0;
    float perimeter = 0.0;
    for (uint j = 0u; j < n; ++j) {
        const vec2 a = contour_points[out_base + j];
        const vec2 b = contour_points[out_base + ((j + 1u) % n)];
        area += a.x * b.y - b.x * a.y;
        perimeter += length(b - a);
    }
    area = abs(area) * 0.5;

    const uint slot = label_id - 1u;
    area_perimeter[slot] = vec2(area, perimeter);

    if (area < pc.min_area) {
        contour_point_count[slot] = 0u;
        sort_keys[slot] = NEG_INFINITY;
    } else {
        sort_keys[slot] = area;
    }
}

void main()
{
    if (pc.phase == 0u)
        claim_phase();
    else
        trace_phase();
}
