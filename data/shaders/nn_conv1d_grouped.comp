#version 460
#extension GL_EXT_buffer_reference : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, std430) readonly buffer FloatRef {
    float v[];
};

layout(buffer_reference, std430) buffer ResultRef {
    float v[];
};

layout(push_constant) uniform PC {
    FloatRef src;
    FloatRef weights;
    FloatRef bias;
    ResultRef dst;
    uint batch;
    uint c_in;
    uint t_in;
    uint c_out;
    uint t_out;
    uint kernel_size;
    uint stride;
    uint pad;
    uint flags;
    uint groups;
} pc;

const uint FLAG_BIAS = 1u;
const uint ACT_SHIFT = 2u;
const uint ACT_RELU = 1u;
const uint ACT_SIGMOID = 2u;
const uint ACT_GELU = 3u;

const float INV_SQRT2 = 0.70710678118654752;

float gelu(float x)
{
    const float z = abs(x) * INV_SQRT2;
    const float t = 1.0 / (1.0 + 0.3275911 * z);
    const float poly = t * (0.254829592 + t * (-0.284496736 + t * (1.421413741 + t * (-1.453152027 + t * 1.061405429))));
    const float tail = 0.5 * poly * exp(-z * z);
    return x * (x >= 0.0 ? 1.0 - tail : tail);
}

uint invocation_index()
{
    return gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
}

/**
 * @brief Grouped one dimensional convolution over [batch, c_in, t_in] into [batch, c_out, t_out].
 *
 * The channels are split into groups equal runs and output channel co reads
 * only the input channels of its own run, so weights are
 * [c_out, c_in / groups, kernel_size]. The input is zero padded by pad on both
 * sides and windows advance by stride. t_out may be smaller than the padded
 * input allows, which drops outputs from the end. flags: bit 0 adds bias, bits
 * 2 and 3 pick the output activation (0 none, 1 ReLU, 2 sigmoid, 3 GELU).
 */
void main()
{
    const uint idx = invocation_index();
    if (idx >= pc.batch * pc.c_out * pc.t_out)
        return;

    const uint to = idx % pc.t_out;
    const uint co = (idx / pc.t_out) % pc.c_out;
    const uint n = idx / (pc.t_out * pc.c_out);

    const uint in_per_group = pc.c_in / pc.groups;
    const uint out_per_group = pc.c_out / pc.groups;
    const uint first_in = (co / out_per_group) * in_per_group;

    float acc = 0.0;
    if ((pc.flags & FLAG_BIAS) != 0u)
        acc = pc.bias.v[co];

    const int start = int(to * pc.stride) - int(pc.pad);
    const uint k_first = uint(max(-start, 0));
    const uint k_end = uint(clamp(int(pc.t_in) - start, 0, int(pc.kernel_size)));

    for (uint j = 0u; j < in_per_group; ++j) {
        const uint x_base = (n * pc.c_in + first_in + j) * pc.t_in;
        const uint w_base = (co * in_per_group + j) * pc.kernel_size;
        for (uint k = k_first; k < k_end; ++k) {
            acc += pc.weights.v[w_base + k] * pc.src.v[x_base + uint(start + int(k))];
        }
    }

    const uint activation = (pc.flags >> ACT_SHIFT) & 3u;
    if (activation == ACT_RELU)
        acc = max(acc, 0.0);
    else if (activation == ACT_SIGMOID)
        acc = 1.0 / (1.0 + exp(-acc));
    else if (activation == ACT_GELU)
        acc = gelu(acc);

    pc.dst.v[idx] = acc;
}
