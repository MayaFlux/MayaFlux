#version 460
#include "include/vision_common.glsl"
#include "include/vision_cc.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 6, std430) buffer DenseLabelBuf {
    uint dense_label[];
};

struct Segment {
    uint label_id;
    uint gx0;
    uint gy0;
    uint gx1;
    uint gy1;
    float x0;
    float y0;
    float x1;
    float y1;
};

layout(set = 1, binding = 0, std430) buffer SegmentBuf {
    Segment segments[];
};

layout(set = 1, binding = 1, std430) buffer SegmentCountBuf {
    uint segment_count[1];
};

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint max_segments;
} pc;

uint label_at(int x, int y)
{
    if (x < 0 || y < 0 || x >= int(pc.width) || y >= int(pc.height))
        return CC_BACKGROUND;
    return dense_label[uint(y) * pc.width + uint(x)];
}

vec2 normalise(float x, float y)
{
    return vec2(x / float(pc.width), y / float(pc.height));
}

/**
 * @brief Emit one segment. Grid coordinates (ga, gb) are the exact
 *        integer pixel-boundary coordinates the endpoints sit on,
 *        passed through directly from the caller's integer math rather
 *        than re-derived from the normalised floats, since float
 *        division then multiplication is not guaranteed to round-trip
 *        exactly back to the same integer for arbitrary widths/heights.
 *        contour_link.comp indexes its endpoint grid from gx/gy, never
 *        from x0/y0/x1/y1.
 */
void emit_segment(uint label_id, uvec2 ga, uvec2 gb, vec2 a, vec2 b)
{
    uint slot = atomicAdd(segment_count[0], 1u);
    if (slot >= pc.max_segments)
        return;

    segments[slot] = Segment(label_id, ga.x, ga.y, gb.x, gb.y, a.x, a.y, b.x, b.y);
}

/**
 * @brief Boundary-edge extraction using dense_label as a discrete field.
 *        One thread per pixel, fully independent. No marching-squares
 *        interpolation is performed since the field is discrete labels,
 *        not a continuous scalar: a boundary either exists at a pixel
 *        edge or it does not.
 *
 * Each thread checks its right and bottom 4-connected neighbours. A
 * boundary exists wherever two neighbouring pixels disagree. The crossed
 * pixel edge is emitted as a segment in normalised [0,1] space, wound
 * from the foreground side's perspective, carrying both the normalised
 * endpoints (for CPU-side polygon output) and the exact integer grid
 * coordinates those endpoints sit on (for contour_link.comp's adjacency
 * lookup, which must not round-trip through float conversion).
 */
void main()
{
    const ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height))
        return;

    const uint here = label_at(coord.x, coord.y);

    {
        const uint right = label_at(coord.x + 1, coord.y);
        if (right != here) {
            const uint ex = uint(coord.x + 1);
            const uvec2 ga = uvec2(ex, uint(coord.y));
            const uvec2 gb = uvec2(ex, uint(coord.y + 1));
            const vec2 a = normalise(float(ga.x), float(ga.y));
            const vec2 b = normalise(float(gb.x), float(gb.y));
            if (here != CC_BACKGROUND)
                emit_segment(here, ga, gb, a, b);
            if (right != CC_BACKGROUND)
                emit_segment(right, gb, ga, b, a);
        }
    }

    {
        const uint below = label_at(coord.x, coord.y + 1);
        if (below != here) {
            const uint ey = uint(coord.y + 1);
            const uvec2 ga = uvec2(uint(coord.x + 1), ey);
            const uvec2 gb = uvec2(uint(coord.x), ey);
            const vec2 a = normalise(float(ga.x), float(ga.y));
            const vec2 b = normalise(float(gb.x), float(gb.y));
            if (here != CC_BACKGROUND)
                emit_segment(here, ga, gb, a, b);
            if (below != CC_BACKGROUND)
                emit_segment(below, gb, ga, b, a);
        }
    }
}
