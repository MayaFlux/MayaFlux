#version 460

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 1, std430) buffer DetCountBuf {
    uint det_count[];
};

layout(set = 1, binding = 0, std430) buffer PrevCountBuf {
    uint prev_count[];
};

layout(set = 1, binding = 3, std430) buffer MetaBuf {
    uint meta[];
};

layout(set = 1, binding = 5, std430) buffer CounterBuf {
    uint ctr[];
};

/**
 * @brief Initializes the flow context's GPU-resident counters, including the
 *        track id counter. Dispatched once when the shared buffers are
 *        allocated, replacing any host-side zero upload.
 */
void main()
{
    const uint i = gl_GlobalInvocationID.x;
    if (i == 0u) {
        det_count[0] = 0u;
        prev_count[0] = 0u;
    }
    if (i < 4u)
        meta[i] = 0u;
    if (i < 16u)
        ctr[i] = 0u;
}
