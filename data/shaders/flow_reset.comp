#version 460
#extension GL_EXT_buffer_reference : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 1, std430) buffer DetCountBuf {
    uint det_count[];
};

layout(buffer_reference, std430) buffer PrevCountBufRef {
    uint v[];
};

layout(buffer_reference, std430) buffer MetaBufRef {
    uint v[];
};

layout(buffer_reference, std430) buffer CounterBufRef {
    uint v[];
};

layout(push_constant) uniform PC {
    PrevCountBufRef prev_count;
    MetaBufRef meta;
    CounterBufRef ctr;
} pc;

/**
 * @brief Initializes the flow context's GPU-resident counters, including the
 *        track id counter. Dispatched once when the shared buffers are
 *        allocated, replacing any host-side zero upload.
 */
void main()
{
    const uint i = gl_GlobalInvocationID.x;
    if (i == 0u) {
        det_count[0] = 0u;
        pc.prev_count.v[0] = 0u;
    }
    if (i < 4u)
        pc.meta.v[i] = 0u;
    if (i < 16u)
        pc.ctr.v[i] = 0u;
}
